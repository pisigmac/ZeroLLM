# Provider API keys for automated sync and model uptime health-checks
# Set these keys in your local environment or CI (e.g. GitHub Actions Secrets)
# Server routes proxy playground requests using user-provided keys, not these keys.

GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Cron protection secret (used to trigger automated cron endpoints)
CRON_SECRET=some_random_secret_string
