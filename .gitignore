# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (preventing committing sensitive credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# (Allow .env.example to be committed)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Mockups and Design Artifacts
public/theme-mockup*
public/*mockup*
*.html

# Python Virtual Environments (if applicable)
venv/
.venv/
env/
__pycache__/

# Antigravity / Gemini Artifacts
.gemini/
brain/
*.plan.md
